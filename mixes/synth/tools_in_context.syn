# Tool calls that are NOT the first thing in an empty conversation.
#
# Every tool example in the other two files opens its conversation, and a model
# trained only on those learns "a tool call is what turn one looks like": give
# it a context, or ask after two lines of small talk, and it answers in prose
# instead of calling anything. These templates put the same calls everywhere
# else they can occur — after chit-chat, under a system context, and with the
# conversation carrying on afterwards.

list chat = how's it going? ; All quiet here. What do you need? | you there? ; Always. What's up? | good morning ; Morning. What can I do? | anything to report? ; Nothing on my end. Go ahead.
list after = what else can you do? ; Apps, the browser, music — ask and I'll try. | thanks ; Any time. | you're quick ; Not much to it. | what's your name again? ; Jarvis.
list ctx = You are Jarvis, the assistant on this machine. | Keep your answers short. | You control one lamp and the desktop applications. | The user prefers brief replies.
list app = Firefox ; firefox | Dolphin ; org.kde.dolphin | OBS Studio ; com.obsproject.Studio | the terminal ; org.kde.konsole | VS Code ; code | Blender ; blender | GIMP ; org.gimp.GIMP | Discord ; discord | Kate ; org.kde.kate | mpv ; mpv
# Twelve different machines, never the same twice — see mixes/synth/apps.syn.
list installed = octopi-notifier, kdesystemsettings, libreoffice-math, jshell-java-openjdk, cmake-gui, nsight-compute, org.kde.konsole, org.kicad.pcbcalculator, renderdoc, cups, supertux2, Sid Meier's Civilization VII | Alacritty, micro, assistant, org.kde.partitionmanager, gimp, jshell-java-openjdk, org.kde.plasma-systemmonitor, org.kde.dolphin, jconsole-java-openjdk, octopi-repoeditor, octopi-notifier, code, bvnc, org.kicad.kicad, linguist, org.kicad.eeschema, org.kde.konsole, libreoffice-base, libreoffice-draw | btop, btrfs-assistant, kdesystemsettings, org.kicad.pcbcalculator, org.kde.kdeconnect.nonplasma, qv4l2, org.kicad.eeschema, cachyos-hello, libreoffice-calc | bvnc, cachyos-hello, org.prismlauncher.PrismLauncher, org.kde.kmenuedit, btrfs-assistant, org.kicad.eeschema, cachyos-pi, lstopo, org.kde.kdeconnect.nonplasma, supertux2, org.kicad.kicad, code | org.kicad.bitmap2component, blender, org.kde.gwenview, org.pulseaudio.pavucontrol, qvidcap, libreoffice-startcenter, libreoffice-draw, org.prismlauncher.PrismLauncher, org.kde.konsole, com.obsproject.Studio, org.kde.dolphin, DaVinciControlPanelsSetup | blackmagicraw-speedtest, org.kde.partitionmanager, supertux2, blackmagicraw-player, org.cachyos.KernelManager, org.kde.kdeconnect.app, code | org.kde.plasma-systemmonitor, org.kicad.pcbnew, org.kde.kwrite, blender, vim, org.kde.konsole, cachyos-hello, cups, nsight-systems, org.kicad.bitmap2component, bvnc, DaVinciResolve | org.cachyos.KernelManager, org.kde.kate, org.prismlauncher.PrismLauncher, Alacritty, blender, org.kde.kwalletmanager, cups, assistant, DaVinciControlPanelsSetup, libreoffice-math, bvnc, org.kde.konsole, org.kde.kmenuedit, cmake-gui, org.kde.dolphin | cachyos-pi, com.obsproject.Studio, libreoffice-math, linguist, libreoffice-base, bvnc, discord, firefox, designer, assistant, blackmagicraw-speedtest, libreoffice-impress, org.kde.konsole, org.kde.plasma-systemmonitor, org.kde.ark | qv4l2, org.kde.kate, org.kde.kwrite, org.kde.plasma-systemmonitor, lstopo, cachyos-pi, org.kde.konsole, steam, nsight-compute, org.kicad.gerbview, micro, mpv, org.kde.kinfocenter, jshell-java-openjdk, DaVinciResolve, qdbusviewer, btop, avahi-discover, cups | bvnc, Sid Meier's Civilization VII, cachyos-pi, org.kde.plasma.emojier, libreoffice-base, btrfs-assistant, org.kde.kcalc | cachyos-pi, org.kde.konsole, org.kde.dolphin, mpv, org.kde.kinfocenter, org.kde.kwrite, org.kicad.eeschema, org.kde.gwenview, jshell-java-openjdk

# Small talk first, tool call second.
template
user      = {chat.0}
assistant = {chat.1}
user      = {turn|switch} on the {light|lamp}
assistant = <tool>lamp.set(on=true)</tool>
tool      = on
assistant = {Done|There you go}.
category  = tools_in_context

template
user      = {chat.0}
assistant = {chat.1}
user      = {open|start} {app.0}
assistant = <tool>app.launch(name="{app.1}")</tool>
tool      = ok
assistant = {app.0} is up.
category  = tools_in_context

# A filled <CONTEXT> slot must not stop it calling anything.
template
system    = {ctx.0}
user      = {turn|switch} on the {light|lamp}
assistant = <tool>lamp.set(on=true)</tool>
tool      = on
assistant = {Done|Light's on}.
category  = tools_in_context

template
system    = {ctx.0}
user      = {open|start} {app.0}
assistant = <tool>app.launch(name="{app.1}")</tool>
tool      = ok
assistant = {app.0} is {up|open}.
category  = tools_in_context

template
system    = {ctx.0}
user      = {chat.0}
assistant = {chat.1}
user      = is the {light|lamp} on?
assistant = <tool>lamp.state()</tool>
tool      = off
assistant = {It's off.|No — off right now.} {Want it on?|}
category  = tools_in_context

# The conversation carries on after a call: prose follows a tool result without
# another call being needed.
template
user      = {turn|switch} on the {light|lamp}
assistant = <tool>lamp.set(on=true)</tool>
tool      = on
assistant = {Done|There you go}.
user      = {after.0}
assistant = {after.1}
category  = tools_in_context

template
user      = {open|start} {app.0}
assistant = <tool>app.launch(name="{app.1}")</tool>
tool      = ok
assistant = {app.0} is up.
user      = {after.0}
assistant = {after.1}
category  = tools_in_context

# Prose, then a call, then prose again — three registers in one conversation.
template
user      = {chat.0}
assistant = {chat.1}
user      = {open|start} {app.0}
assistant = <tool>app.launch(name="{app.1}")</tool>
tool      = ok
assistant = {Open|Up now}.
user      = {after.0}
assistant = {after.1}
category  = tools_in_context

# Two different tools in one conversation, neither of them in turn one.
template
user      = {chat.0}
assistant = {chat.1}
user      = {turn|switch} on the {light|lamp}
assistant = <tool>lamp.set(on=true)</tool>
tool      = on
assistant = {Done|There you go}.
user      = {and|now} {open|start} {app.0}
assistant = <tool>app.launch(name="{app.1}")</tool>
tool      = ok
assistant = {app.0} too. {Anything else?|}
category  = tools_in_context

# The recovery chain, reached mid-conversation rather than from a cold start.
template
system    = {ctx.0}
user      = {chat.0}
assistant = {chat.1}
user      = {open|start} the music app
assistant = <tool>app.launch(name="musicapp")</tool>
tool      = not_found
assistant = <tool>app.list()</tool>
tool      = {installed.0}
assistant = <tool>app.launch(name="spotify")</tool>
tool      = ok
assistant = {That'd be Spotify — it's up.|Spotify, that is. Opened it.}
category  = tools_in_context
